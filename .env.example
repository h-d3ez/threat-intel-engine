# ---- Secrets (copy to .env and CHANGE THESE) ----
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis
INGEST_API_KEY=change-me-long-random-string

# ---- Postgres ----
POSTGRES_USER=tie
POSTGRES_DB=tie

# ---- Threat intel ----
# mock = deterministic offline provider (no API keys needed). real = AbuseIPDB/VirusTotal.
INTEL_MODE=mock
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
INTEL_CACHE_TTL_SECONDS=86400

# ---- Detection thresholds (rule defaults from the spec) ----
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_SECONDS=60
SPRAY_DISTINCT_USERS=4
SPRAY_WINDOW_SECONDS=300
IMPOSSIBLE_TRAVEL_MAX_KMH=900

# ---- Alerting ----
ALERT_COOLDOWN_SECONDS=900
# Discord/Slack/PagerDuty-compatible endpoint. Leave empty to log alerts only.
WEBHOOK_URL=
WEBHOOK_FORMAT=slack
# slack | discord | generic

# ---- Pipeline ----
EVENT_STREAM_MAXLEN=100000
LOG_LEVEL=INFO
